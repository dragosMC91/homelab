#!/bin/sh
# Blocks commits that contain anything shaped like a secret (auth keys, tokens, passwords).
# Enabled per clone by `make setup` (git config core.hooksPath .githooks).
command -v gitleaks >/dev/null || { echo "gitleaks is not installed, so the secret scan can't run. Install it (brew install gitleaks, or apt install gitleaks), or skip once with git commit --no-verify." >&2; exit 1; }
exec gitleaks git --staged --redact

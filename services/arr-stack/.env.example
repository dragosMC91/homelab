TZ=Europe/Bucharest
PUID=1000
PGID=1000
MEDIA_ROOT=/mnt/nas-hdd/media

# Required: Tailscale IP of this host. The qBittorrent, Prowlarr, Radarr,
# Sonarr and Bazarr web UIs publish on it only.
# Find it with: docker exec tailscale tailscale ip -4
TAILSCALE_IP=

# Web UI ports
QBIT_PORT=8083
PROWLARR_PORT=9696
RADARR_PORT=7878
SONARR_PORT=8989
SEERR_PORT=5055
BAZARR_PORT=6767
